{
  "name": "allfulfilled",
  "version": "0.3.0",
  "description": "Use Promise.allSettled like Promise.all",
  "homepage": "https://github.com/airmrcr/node-allfulfilled",
  "bugs": {
    "url": "https://github.com/airmrcr/node-allfulfilled/issues"
  },
  "author": {
    "name": "airmrcr",
    "url": "https://github.com/airmrcr"
  },
  "funding": [
    {
      "type": "individual",
      "url": "https://github.com/sponsors/airmrcr"
    },
    {
      "type": "patreon",
      "url": "https://www.patreon.com/airmrcr"
    }
  ],
  "license": "MIT",
  "keywords": [
    "promise"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/airmrcr/node-allfulfilled.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "types": "./dist/commonjs/index.d.ts",
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "scripts": {
    "build": "tshy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run verify",
    "pretest": "tsc --noEmit && mkdirp coverage",
    "test": "node --import tsx --enable-source-maps --test --experimental-test-coverage --test-reporter spec --test-reporter lcov --test-reporter-destination stdout --test-reporter-destination coverage/lcov.info --test-coverage-include \"src/**\" \"test/**/*.test.ts\"",
    "verify": "npm run build && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-prettier": "^5.5.3",
    "globals": "^17.3.0",
    "mkdirp": "^3.0.1",
    "prettier": "^3.8.1",
    "tshy": "^4.1.4",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.0"
  },
  "tshy": {
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json"
    }
  }
}
